diff --git a/ipc/shm.c b/ipc/shm.c
index 492fcc699985..8d8be78ae889 100644
--- a/ipc/shm.c
+++ b/ipc/shm.c
@@ -155,6 +155,8 @@ pure_initcall(ipc_ns_init);
 
