From ac010d5e031a1ff5ae9a59474aa0a2968b0981ba Mon Sep 17 00:00:00 2001
From: OpenWrt community <openwrt-devel@lists.openwrt.org>
Date: Wed, 13 Jul 2022 12:17:21 +0200
Subject: [PATCH 052/169] spi-nor/esmt.c: add esmt f25l16pa

This fixes support for Dongwon T&I DW02-412H which uses F25L16PA(2S)
flash.
---
 drivers/mtd/spi-nor/esmt.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/mtd/spi-nor/esmt.c b/drivers/mtd/spi-nor/esmt.c
index 089fcd1aa794..3c546c5d5d9b 100644
--- a/drivers/mtd/spi-nor/esmt.c
+++ b/drivers/mtd/spi-nor/esmt.c
@@ -10,6 +10,12 @@
 
 static const struct flash_info esmt_nor_parts[] = {
 	{
+		.id = SNOR_ID(0x8c, 0x21, 0x15),
+		.name = "f25l16pa-2s",
+		.size = SZ_2M,
+		.flags = SPI_NOR_HAS_LOCK,
+		.no_sfdp_flags = SECT_4K,
+	}, {
 		.id = SNOR_ID(0x8c, 0x20, 0x16),
 		.name = "f25l32pa",
 		.size = SZ_4M,
-- 
2.25.1

