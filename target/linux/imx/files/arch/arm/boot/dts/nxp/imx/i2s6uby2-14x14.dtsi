	};
};

&iomuxc_snvs {
        pinctrl-names = "default_snvs";
        pinctrl-0 = <&pinctrl_hog_2>;
        imx6ul-i2s6ull {
		pinctrl_hog_2: hoggrp-2 {
			fsl,pins = <
				MX6ULL_PAD_SNVS_TAMPER0__GPIO5_IO00      0x1b0b0
			>;
		};
	};
};


&lcdif {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&pxp {
	status = "disabled";
};

&sai2 {
	status = "disabled";
};

&tsc {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&usbotg1 {
	dr_mode = "otg";
	srp-disable;
	hnp-disable;
	adp-disable;
	status = "disabled";
};

&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "disabled";
};

&usbphy1 {
	tx-d-cal = <0x5>;
};

&usbphy2 {
	tx-d-cal = <0x5>;
};

&usdhc1 {
	status = "disabled";
};

&usdhc2 {
	status = "disabled";
};

&wdog1 {
	status = "disabled";
};

&wdog2 {
	status = "disabled";
};

&adc1 {
	vref-supply = <&reg_vref_3v3>;
	status = "disabled";
};
