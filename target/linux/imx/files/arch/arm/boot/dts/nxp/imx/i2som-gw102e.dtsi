/ {
	model = "i2SOM GW102";
	compatible = "i2som,i2s6ullemmc", "i2som,i2s6ull", "i2som,i2s6ull14x14", "fsl,imx6ull";

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_sd1_vmmc: regulator@1 {
			compatible = "regulator-fixed";
			regulator-name = "VSD_3V3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};
	};

	rfkill_lte {
		compatible = "rfkill-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_lte_pin>;
		reset-gpios = <&gpio1 18 GPIO_ACTIVE_LOW>;
		shutdown-gpios = <&gpio5 5 GPIO_ACTIVE_HIGH>;
		type = "wwan";
		status = "disabled";
	};

	rfkill_lora {
		compatible = "rfkill-gpio";
		shutdown-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio5 4 GPIO_ACTIVE_LOW>;
		type = "wwan";
		status = "disabled";
	};

	rfkill_wifi {
		compatible = "rfkill-gpio";
		shutdown-gpios = <&gpio5 7 GPIO_ACTIVE_LOW>;
		type = "wlan";
		status = "disabled";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;

		cpu {
			label = "cpu";
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_keys>;

		user {
			label = "user";
			gpios = <&gpio3 16 GPIO_ACTIVE_LOW>;
			gpio-key,wakeup;
			linux,code = <KEY_CONFIG>;
		};
	};

	watchdog: watchdog {
		compatible = "linux,wdt-gpio";
		pinctrl-names = "default";
		gpios = <&gpio5 1 GPIO_ACTIVE_LOW>;
		hw_algo = "toggle";
		hw_margin_ms = <1000>;
		always-running;
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog_1>;
	imx6ul-i2s6ull {
		pinctrl_hog_1: hoggrp-1 {
			fsl,pins = <
				MX6UL_PAD_UART1_RTS_B__GPIO1_IO19	0x17059 /* SD1 CD */
				MX6UL_PAD_CSI_DATA03__GPIO4_IO24	0x1b0b0 /* GPIO Watchdog Enable */
			>;
		};

		pinctrl_lora_pin: loragrp {
			fsl,pins = <
				MX6UL_PAD_GPIO1_IO09__GPIO1_IO09	0x1b0b0 /* LoRa Power Enable */
			>;
		};


		pinctrl_lte_reset: ltereset {
			fsl,pins = <
				MX6UL_PAD_UART1_CTS_B__GPIO1_IO18	0x40017059  /* LTE Reset */
			>;
		};

		pinctrl_usb_otg1_id: usbotg1idgrp {
			fsl,pins = <
				MX6UL_PAD_GPIO1_IO00__ANATOP_OTG1_ID    0x17059
			>;
		};

		pinctrl_gpio_keys: gpiokeys {
			fsl,pins = <
				MX6UL_PAD_LCD_DATA11__GPIO3_IO16	0x1b0b0
			>;
		};

		pinctrl_uart3_rede: uart3_rede {
			fsl,pins = <
				MX6UL_PAD_LCD_CLK__GPIO3_IO00		0x4001b0b1
			>;
		};

		pinctrl_uart6_rede: uart6_rede {
			fsl,pins = <
				MX6UL_PAD_CSI_VSYNC__GPIO4_IO19     0x4001b0b1
			>;
		};

		pinctrl_uart8dce_alt1: uart8dcegrp_alt1 {
			fsl,pins = <
				MX6UL_PAD_LCD_DATA20__UART8_DCE_TX	0x1b0b1
				MX6UL_PAD_LCD_DATA21__UART8_DCE_RX	0x1b0b1
			>;
		};

		pinctrl_uart5dce_alt2: uart5dcegrp_alt2 {
			fsl,pins = <
				MX6UL_PAD_UART5_TX_DATA__UART5_DCE_TX	0x1b0b1
				MX6UL_PAD_UART5_RX_DATA__UART5_DCE_RX	0x1b0b1
			>;
		};

		pinctrl_ecspi1_cs_1: ecspi1_cs_grp-1 {
			fsl,pins = <
				MX6UL_PAD_CSI_DATA05__GPIO4_IO26        0x10b0
			>;
		};
	};
};

&iomuxc_snvs {
	pinctrl-names = "default_snvs";
        pinctrl-0 = <&pinctrl_hog_2>;
        imx6ul-i2s6ull {
		pinctrl_hog_2: hoggrp-2 {
                        fsl,pins = <
                                MX6ULL_PAD_SNVS_TAMPER1__GPIO5_IO01	0x1b0b0 /* GPIO Watchdog WDI */
                                /*MX6ULL_PAD_SNVS_TAMPER5__GPIO5_IO05	0x1b0b0  LTE Power Enable */
                                MX6ULL_PAD_SNVS_TAMPER6__GPIO5_IO06	0x1b0b0 /* ENET2 Reset */
                                MX6ULL_PAD_SNVS_TAMPER4__GPIO5_IO04	0x40017059 /* LoRa Reset */
                        >;
                };

		pinctrl_lte_pin: ltegrp {
			fsl,pins = <
                                MX6ULL_PAD_SNVS_TAMPER5__GPIO5_IO05	0x1b0b0 /* LTE Power Enable */
			>;
		};

		pinctrl_wifi_pin: wifigrp {
			fsl,pins = <
                                MX6ULL_PAD_SNVS_TAMPER7__GPIO5_IO07	0x1b0b0 /* WiFi Power Enable */
			>;
		};

		pinctrl_leds: ledgrp {
			fsl,pins = <
				MX6ULL_PAD_SNVS_TAMPER2__GPIO5_IO02	0x1b0b0
			>;
		};

		pinctrl_uart4_rede: uart4_rede {
			fsl,pins = <
				MX6ULL_PAD_SNVS_TAMPER9__GPIO5_IO09	0x4001b0b1
			>;
		};

		pinctrl_uart5_rede: uart5_rede {
			fsl,pins = <
				MX6ULL_PAD_SNVS_TAMPER8__GPIO5_IO08	0x4001b0b1
			>;
		};
	};
};

&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet1>;
	phy-mode = "rmii";
	phy-handle = <&ethphy0>;
	status = "okay";
	/delete-node/ mdio;
};

&fec2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet2 &pinctrl_enet2_mdio>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;
	phy-reset-gpios = <&gpio5 6 GPIO_ACTIVE_LOW>;
	phy-reset-duration = <50>;
    phy-reset-post-delay = <50>;
	// i2som,phy-reset-in-suspend;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			smsc,disable-energy-detect;
			reg = <0>;
			clocks = <&clks IMX6UL_CLK_ENET_REF>;
			clock-names = "rmii-ref";
		};

		ethphy1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			smsc,disable-energy-detect;
			reg = <1>;
			clocks = <&clks IMX6UL_CLK_ENET2_REF>;
			clock-names = "rmii-ref";
		};
	};
};

&lcdif {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&tsc {
	status = "disabled";
};

&usbotg1 {
	dr_mode = "host";
	disable-over-current;
	status = "disabled";
};

&usbotg2 {
	dr_mode = "host";
	disable-over-current;
	status = "disabled";
};

&usbphy1 {
	tx-d-cal = <0x5>;
};

&usbphy2 {
	tx-d-cal = <0x5>;
};

&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	cd-gpios = <&gpio1 19 GPIO_ACTIVE_LOW>;
	keep-power-in-suspend;
	vmmc-supply = <&reg_sd1_vmmc>;
	no-1-8-v;
	status = "disabled";
};

&i2c1 {
	clock_frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1_alt2>;
	status = "okay";

	rx8025: rx8025@32 {
		compatible = "epson,rx8025";
		reg = <0x32>;
	};
};

&ecspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1_1 &pinctrl_ecspi1_cs_1>;
	fsl,spi-num-chipselects = <1>;
	cs-gpios = <&gpio4 26 0>;
	status = "disabled";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <8000000>;
	};
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2dce>;
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4dce_alt1 &pinctrl_uart4_rede>;
	/*uart-has-rtscts;*/
	rts-gpios = <&gpio5 9 GPIO_ACTIVE_HIGH>;
    /* GPIO5_IO09 → DE+RE (active high = transmit) */
	// fsl,rs485-gpio-txen = <&gpio5 9 GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
};

&uart6 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart6dce_alt1 &pinctrl_uart6_rede>;
	/*uart-has-rtscts;*/
	rts-gpios = <&gpio4 19 GPIO_ACTIVE_HIGH>;
	/*fsl,rs485-gpio-txen = <&gpio1 8 GPIO_ACTIVE_HIGH>;*/
    linux,rs485-enabled-at-boot-time;
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7dce_alt1>;
};

