From 402f341c0be92b587a50246b760cd9bb739ff203 Mon Sep 17 00:00:00 2001
From: Ye Li <ye.li@nxp.com>
Date: Mon, 15 Dec 2025 11:25:52 +0800
Subject: [PATCH 1/2] LFU-953-1 arm: dts: imx93w-evk: Add DTS file for iMX93W
 EVK

i.MX93W has i.MX93 and IW610 WLCSP in one package. The i.MX93W
EVK reuses i.MX93 11x11 EVK with some minor changes as below. Since
the imx93-11x11-evk.dts in u-boot dts/upstream does not include SDIO
and WIFI, we only add part of kernel DTS changes mainly
for the I2C3 pins into u-boot.

Signed-off-by: Ye Li <ye.li@nxp.com>
Reviewed-by: Peng Fan <peng.fan@nxp.com>
---
 arch/arm/dts/Makefile               |  3 ++-
 arch/arm/dts/imx93w-evk-u-boot.dtsi | 18 +++++++++++++++
 arch/arm/dts/imx93w-evk.dts         | 36 +++++++++++++++++++++++++++++
 3 files changed, 56 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/dts/imx93w-evk-u-boot.dtsi
 create mode 100644 arch/arm/dts/imx93w-evk.dts

diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index e854de7fd3d..05ab05b075d 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -975,7 +975,8 @@ dtb-$(CONFIG_ARCH_IMX9) += \
 	imx91-11x11-frdm-imx91s.dtb \
 	imx93-var-som-symphony.dtb \
 	imx93-phyboard-segin.dtb \
-	imx93-11x11-frdm.dtb
+	imx93-11x11-frdm.dtb \
+	imx93w-evk.dtb
 
 dtb-$(CONFIG_ARCH_IMXRT) += imxrt1050-evk.dtb \
 	imxrt1020-evk.dtb \
diff --git a/arch/arm/dts/imx93w-evk-u-boot.dtsi b/arch/arm/dts/imx93w-evk-u-boot.dtsi
new file mode 100644
index 00000000000..5438217d257
--- /dev/null
+++ b/arch/arm/dts/imx93w-evk-u-boot.dtsi
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 NXP
+ */
+
+#include "imx93-11x11-evk-u-boot.dtsi"
+
+&pinctrl_lpi2c3_gpio {
+       fsl,pins = <
+               MX93_PAD_GPIO_IO00__GPIO2_IO00                  0x31e
+               MX93_PAD_GPIO_IO01__GPIO2_IO01                  0x31e
+       >;
+};
+
+&lpi2c3 {
+	gpios = <&gpio2 0 GPIO_ACTIVE_LOW>,
+		<&gpio2 1 GPIO_ACTIVE_LOW>;
+};
diff --git a/arch/arm/dts/imx93w-evk.dts b/arch/arm/dts/imx93w-evk.dts
new file mode 100644
index 00000000000..a66b19e4cec
--- /dev/null
+++ b/arch/arm/dts/imx93w-evk.dts
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 NXP
+ */
+
+#include "../dts/upstream/src/arm64/freescale/imx93-11x11-evk.dts"
+
+/ {
+	model = "NXP i.MX93W EVK board";
+	compatible = "fsl,imx93w-evk", "fsl,imx93";
+
+	sound-bt-sco {
+		status = "disabled";
+	};
+
+	sound-micfil {
+		status = "disabled";
+	};
+};
+
+&micfil {
+	status = "disabled";
+};
+
+&sai1 {
+	status = "disabled";
+};
+
+&iomuxc {
+	pinctrl_lpi2c3: lpi2c3grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO00__LPI2C3_SDA			0x40000b9e
+			MX93_PAD_GPIO_IO01__LPI2C3_SCL			0x40000b9e
+		>;
+	};
+};
-- 
2.25.1

